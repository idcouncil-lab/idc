# منع الوصول لمجلد Git بالكامل
RedirectMatch 404 /\.git

# منع الوصول لأي ملف/مجلد يبدأ بنقطة (.git, .firebase, .firebaserc, .gitignore, .github ...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# منع تصفح محتويات المجلدات (Directory Listing)
Options -Indexes

# منع الوصول لملفات التوثيق/الميتاداتا الداخلية إن بقيت بالخطأ
<FilesMatch "\.(md|log|env|bak|backup)$">
    Require all denied
</FilesMatch>
